# Dependências — sem âncora `/`, para cobrir também meal-control/*/node_modules
node_modules/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example
*.pem

# Estado em disco (anexos de usuário, arquivos dos módulos)
/storage
/uploads

# Saída de testes
/coverage

# Logs — inclui o pm2-health.log gerado pelo monitor via cron
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Artefatos gerados em depuração (PDF de recibo, dumps de estrutura)
/recibo-*.pdf
/backend-structure*.json

# Configuração local do Claude Code
/.claude/*

# Sistema
.DS_Store
Thumbs.db
