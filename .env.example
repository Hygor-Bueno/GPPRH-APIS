# =====================================================================
# JWT
# =====================================================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_ACCESS_IN=30m
JWT_EXPIRES_REFRESH_IN=3d

# JWT por backend (usado pelo docker-compose.yml)
# Os backends interno e público assinam token com segredos DIFERENTES, para que
# um token de candidato não seja verificável pelo backend interno e vice-versa.
# O compose injeta estes valores sobrescrevendo os JWT_* acima em cada container.
# Gere cada um com: openssl rand -hex 48
INTERNAL_JWT_ACCESS_SECRET=
INTERNAL_JWT_REFRESH_SECRET=
PUBLIC_JWT_ACCESS_SECRET=
PUBLIC_JWT_REFRESH_SECRET=

# Cookies
COOKIE_MAX_AGE_ACCESS=30m
COOKIE_MAX_AGE_REFRESH=3d

# =====================================================================
# ACTIVE DIRECTORY
# =====================================================================
AD_URL=ldap://10.10.10.XX
AD_DOMAIN=
AD_BASEDN=DC=,DC=com

# =====================================================================
# Protheus (SQL Server)
# =====================================================================
PROTHEUS_DB_USER=
PROTHEUS_DB_PASSWORD=
PROTHEUS_DB_SERVER=
PROTHEUS_DB_DATABASE=TMPPRD12
PROTHEUS_DB_PORT=1433
PROTHEUS_DB_OPTIONS_ENCRYPT=false

# =====================================================================
# GIPP no SQL Server
# =====================================================================
GIPP_SQLSERVER_DB_USER=
GIPP_SQLSERVER_DB_PASSWORD=
GIPP_SQLSERVER_DB_SERVER=
GIPP_SQLSERVER_DB_DATABASE=GIPP
GIPP_SQLSERVER_DB_PORT=1433
GIPP_SQLSERVER_DB_OPTIONS_ENCRYPT=false

# =====================================================================
# App
# =====================================================================
PORT=4000
NODE_ENV=dev
# Portas dos backends separados (definidas pelo docker-compose; default no código)
# PORT_INTERNAL=4002
# PORT_PUBLIC=4010

# Google OAuth
GOOGLE_CLIENT_ID=

# =====================================================================
# MySQL — banco gpprh (local, servidor de aplicação)
# =====================================================================
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=gpprh
MYSQL_PORT=3306

# MySQL — banco global (servidor de dados)
MYSQL_GLOBAL_HOST=10.10.10.XX
MYSQL_GLOBAL_USER=
MYSQL_GLOBAL_PASSWORD=
MYSQL_GLOBAL_DATABASE=global
MYSQL_GLOBAL_PORT=3306

# MySQL — banco GIPP (replicação de pagamentos)
MYSQL_GIPP_HOST=10.10.10.XX
MYSQL_GIPP_USER=
MYSQL_GIPP_PASSWORD=
MYSQL_GIPP_DATABASE=gipp
MYSQL_GIPP_PORT=3306

# =====================================================================
# Oracle (Consinco ERP) — requerido pelo módulo EPP
# Instalar Oracle Instant Client e adicionar ao PATH, ou definir ORACLE_CLIENT_PATH
# =====================================================================
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=10.10.10.XX:1521/orcl
# Opcional — use se o client não estiver no PATH
# Linux/container: /opt/oracle/instantclient_19_27
# Windows:         C:\oracle\instantclient_21_3
ORACLE_CLIENT_PATH=

# =====================================================================
# WebSocket (chat / GTPP)
# =====================================================================
WS_API_KEY=
# Endpoint de emissão de eventos; default http://localhost:4001/ws/emit-event
# (o docker-compose aponta para o container ws-gipp-enterprises)
# WS_EMIT_URL=

# =====================================================================
# Refeitório / reconhecimento facial (módulo meal)
# =====================================================================
# OBRIGATÓRIO para o fluxo de cadastro facial — sem isto as rotas de enroll
# falham com MEAL_ENROLL_SECRET_MISSING. Gere com: openssl rand -hex 48
MEAL_ENROLL_SECRET=
# Opcionais (valores abaixo são os defaults do código)
# MEAL_ENROLL_TTL_DAYS=7
# MEAL_ENROLL_CONFIRMED_TTL_MIN=10
# MEAL_FACE_THRESHOLD=0.5
# MEAL_FACE_MARGIN=0.06
# MEAL_CONSENT_VERSION=refeitorio-facial-v1

# Abrangência da identificação 1:N — `site` (padrão) ou `global`.
#   site   = só quem é da filial ou comeu nela nos últimos 30 dias
#   global = todos os cadastrados não revogados
# `global` é para GALERIA PEQUENA. Com cinco rostos o recorte por loja não reduz
# risco e só impede de achar quem ainda não comeu ali. Quando a base crescer,
# volte para `site` — a conta está em sqlFindIdentifyCandidates.
# Qualquer valor não reconhecido cai em `site`, de propósito.
# MEAL_FACE_IDENTIFY_SCOPE=site

# =====================================================================
# Refeitório / venda de almoço por cupom fiscal (NFC-e)
# =====================================================================
# SEQPRODUTO do almoço no Consinco (MFL_DFITEM). É o que separa o almoço do
# resto do cupom — errar aqui faz todo cupom voltar `no-meal-item`.
# MEAL_COUPON_SEQPRODUTO=69988

# Recusar cupom que não é do dia. DESLIGADO na fase 1 por decisão de produto.
# Enquanto desligado, cupom descartado no lixo vira refeição para quem recolher;
# a resposta traz `is_today` para a tela poder avisar o operador.
# MEAL_COUPON_ENFORCE_DATE=0

# Alcance da BUSCA no Consinco com a trava de data desligada (não é validade do
# cupom). Existe para o índice de DTAMOVIMENTO continuar em seek.
# MEAL_COUPON_LOOKBACK_DAYS=90

# Serviço face (Python/InsightFace) — defaults do código; o compose já define
# FACE_SERVICE_URL e FACE_MAX_IMAGE_BYTES nos containers
# FACE_SERVICE_URL=http://face:8000
# FACE_TIMEOUT_MS=8000
# FACE_MAX_IMAGE_BYTES=12582912

# =====================================================================
# meipp — Mídia Interna e Externa Peg Pese
# =====================================================================
# As tabelas `meipp_*` vivem no MySQL `global` (MYSQL_GLOBAL_*), então não há
# variável de conexão própria.
#
# Os dois segredos abaixo são OBRIGATÓRIOS para o módulo funcionar. Sem eles o
# resto da API sobe normalmente e só as rotas do meipp respondem 500 dizendo
# qual variável falta. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Assina as URLs de entrega de mídia (`GET /meipp/media/:uuid/file?t=...`).
# Trocar este valor invalida todas as URLs já entregues aos players; eles
# voltam a funcionar na próxima chamada de /device/playlist.
# MEIPP_MEDIA_TOKEN_SECRET=

# Assina os códigos de pareamento. Trocar invalida os códigos emitidos e ainda
# não usados — não afeta players já pareados.
# MEIPP_PAIRING_SECRET=

# Prefixo ABSOLUTO das URLs entregues ao player. O Android não tem origem para
# resolver caminho relativo, então sem isto a URL sai quebrada.
# Produção: https://vagas.gpprh.com.br/api/v1/global
# MEIPP_PUBLIC_BASE_URL=http://localhost:4002/api/v1/global

# Validade da URL assinada de mídia, em horas (default 24).
# MEIPP_MEDIA_TOKEN_TTL_HOURS=24

# Validade do código de pareamento, em minutos (default 10). O código é
# assinado, não gravado — não há como cancelá-lo antes de expirar, então este
# número é a janela de risco. Ver meipp-pairing-code.service.js.
# MEIPP_PAIRING_TTL_MINUTES=10

# Validade do token de dispositivo, em dias. AUSENTE = sem expiração, revogável
# só manualmente — é o comportamento pedido no requisito. Definir liga a
# rotação por tempo, e toda tela precisa ser pareada de novo ao vencer.
# MEIPP_DEVICE_TOKEN_TTL_DAYS=

# Playlist tocada quando nenhum agendamento casa (passo 7 do resolvedor).
# AUSENTE = o player mantém o último conteúdo em cache (`keep_cache: true`),
# que é o padrão da v1 — tela preta na loja é pior do que conteúdo de ontem.
# MEIPP_FALLBACK_PLAYLIST_ID=

# Tempo sem heartbeat até a tela ser considerada offline, em minutos (default 5).
# O `status` do player é DERIVADO de `last_seen_at` na leitura — a coluna
# `meipp_players.status` só é escrita pelo heartbeat e ficaria eternamente
# 'online' para uma tela caída. Manter folgado em relação à cadência do
# heartbeat do app: com heartbeat de 1 min, 5 min tolera quatro perdas seguidas.
# MEIPP_OFFLINE_AFTER_MINUTES=5
